<Project>
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
    <Authors>AVA Racing</Authors>
    <Company>AVA Racing</Company>
    <Product>AVA Racing Companion</Product>
    <Copyright>Copyright (c) 2026 AVA Racing</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/jagge1988/ava-racing-companion</RepositoryUrl>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
