<Window x:Class="AvaRacingCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVA Racing Companion"
        Width="480"
        Height="430"
        MinWidth="440"
        MinHeight="400"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#11141A"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Kopfbereich -->
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <Border DockPanel.Dock="Right"
              Background="#1E2530"
              BorderBrush="#2E3747"
              BorderThickness="1"
              CornerRadius="12"
              Padding="10,4"
              VerticalAlignment="Center">
        <TextBlock x:Name="VersionText"
                   Text="v0.1.0"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#9FB3C8" />
      </Border>

      <StackPanel>
        <TextBlock Text="AVA Racing Companion"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#FFFFFF" />
        <TextBlock Text="Phase 1 – Basis &amp; Update-Fundament (noch keine iRacing-Telemetrie)"
                   FontSize="12"
                   Foreground="#8C9BB0"
                   Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>

    <!-- Status-Karte -->
    <Border Grid.Row="1"
            Background="#181D26"
            BorderBrush="#283140"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="0,0,0,12">
      <StackPanel>
        <DockPanel Margin="0,0,0,8">
          <TextBlock Text="Update-Status"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#D8E0EB" />
        </DockPanel>

        <TextBlock x:Name="UpdateStatusText"
                   Text="Bereit. Noch keine Update-Prüfung durchgeführt."
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="#B8C4D4" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="CheckUpdatesButton"
                  Content="Jetzt auf Updates prüfen"
                  Click="OnCheckUpdatesClick"
                  Padding="12,6"
                  Background="#2563EB"
                  Foreground="#FFFFFF"
                  BorderThickness="0"
                  Cursor="Hand" />

          <Button x:Name="ApplyUpdateButton"
                  Content="Jetzt aktualisieren"
                  Click="OnApplyUpdateClick"
                  Visibility="Collapsed"
                  Margin="8,0,0,0"
                  Padding="12,6"
                  Background="#16A34A"
                  Foreground="#FFFFFF"
                  BorderThickness="0"
                  Cursor="Hand" />

          <Button x:Name="OpenReleaseButton"
                  Content="Release / Changelog öffnen"
                  Click="OnOpenReleaseClick"
                  Visibility="Collapsed"
                  Margin="8,0,0,0"
                  Padding="12,6"
                  Background="#2A3342"
                  Foreground="#E5ECF5"
                  BorderThickness="0"
                  Cursor="Hand" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Einstellungen-Karte -->
    <Border Grid.Row="2"
            Background="#181D26"
            BorderBrush="#283140"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14">
      <StackPanel>
        <TextBlock Text="Update-Einstellungen"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Foreground="#D8E0EB"
                   Margin="0,0,0,8" />

        <RadioButton x:Name="AutoUpdateRadio"
                     GroupName="UpdateBehavior"
                     Checked="OnSettingsControlChanged"
                     Foreground="#F2F4F8"
                     Margin="0,0,0,6">
          <StackPanel>
            <TextBlock Text="Auto-Update aktiv" FontWeight="SemiBold" />
            <TextBlock Text="Lädt Updates automatisch und installiert beim Neustart oder per Klick."
                       FontSize="11.5"
                       Foreground="#8C9BB0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>

        <RadioButton x:Name="NotifyOnlyRadio"
                     GroupName="UpdateBehavior"
                     Checked="OnSettingsControlChanged"
                     Foreground="#F2F4F8"
                     Margin="0,4,0,12">
          <StackPanel>
            <TextBlock Text="Auto-Update deaktiviert (Nur benachrichtigen)" FontWeight="SemiBold" />
            <TextBlock Text="Lädt nichts ungefragt herunter. Zeigt nur eine Benachrichtigung mit Link zum GitHub-Release."
                       FontSize="11.5"
                       Foreground="#8C9BB0"
                       TextWrapping="Wrap" />
          </StackPanel>
        </RadioButton>

        <Separator Background="#283140" Margin="0,0,0,10" />

        <CheckBox x:Name="AutostartCheckBox"
                  Content="Mit Windows starten (minimiert im System-Tray)"
                  Checked="OnSettingsControlChanged"
                  Unchecked="OnSettingsControlChanged"
                  Foreground="#F2F4F8" />
      </StackPanel>
    </Border>

    <!-- Fußzeile -->
    <DockPanel Grid.Row="4" Margin="0,12,0,0">
      <TextBlock Text="Schließen minimiert in den System-Tray."
                 FontSize="11.5"
                 Foreground="#748299"
                 VerticalAlignment="Center" />

      <TextBlock DockPanel.Dock="Right"
                 HorizontalAlignment="Right"
                 FontSize="11.5"
                 VerticalAlignment="Center">
        <Hyperlink Click="OnOpenAllReleasesClick" Foreground="#60A5FA">
          GitHub Releases
        </Hyperlink>
      </TextBlock>
    </DockPanel>
  </Grid>
</Window>
