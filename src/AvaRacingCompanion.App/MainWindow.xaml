<Window x:Class="AvaRacingCompanion.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVA Racing Companion"
        Width="520"
        Height="660"
        MinWidth="480"
        MinHeight="620"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#11141A"
        Foreground="#F2F4F8"
        FontFamily="Segoe UI">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Kopfbereich -->
      <DockPanel Grid.Row="0" Margin="0,0,0,14">
        <Border DockPanel.Dock="Right"
                Background="#1E2530"
                BorderBrush="#2E3747"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10,4"
                VerticalAlignment="Center">
          <TextBlock x:Name="VersionText"
                     Text="v0.1.0"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="#9FB3C8" />
        </Border>

        <StackPanel>
          <TextBlock Text="AVA Racing Companion"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#FFFFFF" />
          <TextBlock Text="iRacing 60-Hz-Telemetrie &amp; Stint-Companion für den AVA Discord-Bot"
                     FontSize="12"
                     Foreground="#8C9BB0"
                     Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- Bot-Verbindung & Telemetrie -->
      <Border Grid.Row="1"
              Background="#181D26"
              BorderBrush="#283140"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14"
              Margin="0,0,0,12">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Border x:Name="PendingUploadsBadge"
                    DockPanel.Dock="Right"
                    Background="#253042"
                    CornerRadius="10"
                    Padding="8,2"
                    Visibility="Collapsed">
              <TextBlock x:Name="PendingUploadsText"
                         Text="0 offen"
                         FontSize="11"
                         Foreground="#93C5FD" />
            </Border>
            <TextBlock Text="Bot-Verbindung &amp; iRacing-Telemetrie"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#D8E0EB" />
          </DockPanel>

          <TextBlock x:Name="TelemetryStatusText"
                     Text="Warte auf Discord-Kopplung (/pair) und iRacing."
                     TextWrapping="Wrap"
                     FontSize="12.5"
                     Foreground="#9FB3C8"
                     Margin="0,0,0,10" />

          <!-- Server-URL -->
          <TextBlock Text="Bot-Server-URL (z. B. Tailscale Funnel https://...)"
                     FontSize="11.5"
                     Foreground="#8C9BB0"
                     Margin="0,0,0,4" />
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ServerUrlTextBox"
                     Grid.Column="0"
                     Background="#11141A"
                     Foreground="#F2F4F8"
                     BorderBrush="#334155"
                     Padding="8,5"
                     LostFocus="OnServerUrlLostFocus" />
            <Button x:Name="TestConnectionButton"
                    Grid.Column="1"
                    Content="Testen"
                    Click="OnTestConnectionClick"
                    Margin="8,0,0,0"
                    Padding="12,5"
                    Background="#2A3342"
                    Foreground="#E5ECF5"
                    BorderThickness="0"
                    Cursor="Hand" />
          </Grid>

          <!-- Pairing-Bereich (ungekoppelt) -->
          <StackPanel x:Name="UnpairedPanel" Margin="0,0,0,10">
            <TextBlock Text="Mit Discord koppeln (/pair im Bot ausführen und 6-stelligen Code eingeben)"
                       FontSize="11.5"
                       Foreground="#8C9BB0"
                       Margin="0,0,0,4" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox x:Name="PairCodeTextBox"
                       Grid.Column="0"
                       MaxLength="12"
                       Background="#11141A"
                       Foreground="#F2F4F8"
                       BorderBrush="#334155"
                       Padding="8,5" />
              <Button x:Name="PairButton"
                      Grid.Column="1"
                      Content="Koppeln"
                      Click="OnPairClick"
                      Margin="8,0,0,0"
                      Padding="14,5"
                      Background="#16A34A"
                      Foreground="#FFFFFF"
                      BorderThickness="0"
                      Cursor="Hand" />
            </Grid>
          </StackPanel>

          <!-- Pairing-Bereich (gekoppelt) -->
          <DockPanel x:Name="PairedPanel" Visibility="Collapsed" Margin="0,0,0,10">
            <Button x:Name="UnpairButton"
                    DockPanel.Dock="Right"
                    Content="Trennen"
                    Click="OnUnpairClick"
                    Padding="10,4"
                    Background="#7F1D1D"
                    Foreground="#FEE2E2"
                    BorderThickness="0"
                    Cursor="Hand" />
            <TextBlock x:Name="PairedDriverText"
                       Text="Gekoppelt"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="#4ADE80" />
          </DockPanel>

          <TextBlock x:Name="ConnectionFeedbackText"
                     FontSize="11.5"
                     Foreground="#93C5FD"
                     TextWrapping="Wrap"
                     Visibility="Collapsed"
                     Margin="0,0,0,8" />

          <CheckBox x:Name="TelemetryEnabledCheckBox"
                    Content="iRacing Live-Telemetrie (60 Hz) aktiv"
                    Checked="OnSettingsControlChanged"
                    Unchecked="OnSettingsControlChanged"
                    Foreground="#F2F4F8"
                    Margin="0,0,0,6" />

          <CheckBox x:Name="UploadTracesCheckBox"
                    Content="60-Hz-Runden-Traces für Kurvenanalyse hochladen"
                    Checked="OnSettingsControlChanged"
                    Unchecked="OnSettingsControlChanged"
                    Foreground="#F2F4F8"
                    Margin="0,0,0,6" />

          <CheckBox x:Name="ImportIbtCheckBox"
                    Content="Vorhandene &amp; neue .ibt-Dateien automatisch importieren"
                    Checked="OnSettingsControlChanged"
                    Unchecked="OnSettingsControlChanged"
                    Foreground="#F2F4F8"
                    Margin="0,0,0,8" />

          <DockPanel>
            <Button x:Name="ScanIbtButton"
                    DockPanel.Dock="Right"
                    Content=".ibt jetzt scannen"
                    Click="OnScanIbtClick"
                    Padding="10,4"
                    Background="#2A3342"
                    Foreground="#E5ECF5"
                    BorderThickness="0"
                    Cursor="Hand" />
            <TextBlock Text="Uploads &amp; .ibt-Imports pausieren automatisch, solange du aktiv im Auto sitzt."
                       FontSize="11"
                       Foreground="#8C9BB0"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />
          </DockPanel>
        </StackPanel>
      </Border>

      <!-- Update-Status -->
      <Border Grid.Row="2"
              Background="#181D26"
              BorderBrush="#283140"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14"
              Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Update-Status"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#D8E0EB"
                     Margin="0,0,0,6" />

          <TextBlock x:Name="UpdateStatusText"
                     Text="Bereit. Noch keine Update-Prüfung durchgeführt."
                     TextWrapping="Wrap"
                     FontSize="12.5"
                     Foreground="#B8C4D4" />

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="CheckUpdatesButton"
                    Content="Jetzt auf Updates prüfen"
                    Click="OnCheckUpdatesClick"
                    Padding="12,6"
                    Background="#2563EB"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Cursor="Hand" />

            <Button x:Name="ApplyUpdateButton"
                    Content="Jetzt aktualisieren"
                    Click="OnApplyUpdateClick"
                    Visibility="Collapsed"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    Background="#16A34A"
                    Foreground="#FFFFFF"
                    BorderThickness="0"
                    Cursor="Hand" />

            <Button x:Name="OpenReleaseButton"
                    Content="Release / Changelog öffnen"
                    Click="OnOpenReleaseClick"
                    Visibility="Collapsed"
                    Margin="8,0,0,0"
                    Padding="12,6"
                    Background="#2A3342"
                    Foreground="#E5ECF5"
                    BorderThickness="0"
                    Cursor="Hand" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- App-Einstellungen -->
      <Border Grid.Row="3"
              Background="#181D26"
              BorderBrush="#283140"
              BorderThickness="1"
              CornerRadius="8"
              Padding="14">
        <StackPanel>
          <TextBlock Text="Update- &amp; Start-Einstellungen"
                     FontSize="13"
                     FontWeight="SemiBold"
                     Foreground="#D8E0EB"
                     Margin="0,0,0,8" />

          <RadioButton x:Name="AutoUpdateRadio"
                       GroupName="UpdateBehavior"
                       Checked="OnSettingsControlChanged"
                       Foreground="#F2F4F8"
                       Margin="0,0,0,6">
            <StackPanel>
              <TextBlock Text="Auto-Update aktiv" FontWeight="SemiBold" />
              <TextBlock Text="Lädt Updates automatisch und installiert beim Neustart oder per Klick."
                         FontSize="11.5"
                         Foreground="#8C9BB0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>

          <RadioButton x:Name="NotifyOnlyRadio"
                       GroupName="UpdateBehavior"
                       Checked="OnSettingsControlChanged"
                       Foreground="#F2F4F8"
                       Margin="0,4,0,10">
            <StackPanel>
              <TextBlock Text="Auto-Update deaktiviert (Nur benachrichtigen)" FontWeight="SemiBold" />
              <TextBlock Text="Lädt nichts ungefragt herunter. Zeigt nur eine Benachrichtigung mit Link zum GitHub-Release."
                         FontSize="11.5"
                         Foreground="#8C9BB0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>

          <Separator Background="#283140" Margin="0,0,0,10" />

          <CheckBox x:Name="AutostartCheckBox"
                    Content="Mit Windows starten (minimiert im System-Tray)"
                    Checked="OnSettingsControlChanged"
                    Unchecked="OnSettingsControlChanged"
                    Foreground="#F2F4F8" />
        </StackPanel>
      </Border>

      <!-- Fußzeile -->
      <DockPanel Grid.Row="5" Margin="0,12,0,0">
        <TextBlock Text="Schließen minimiert in den System-Tray."
                   FontSize="11.5"
                   Foreground="#748299"
                   VerticalAlignment="Center" />

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock FontSize="11.5" Margin="0,0,12,0">
            <Hyperlink Click="OnOpenLogClick" Foreground="#60A5FA">
              Log öffnen
            </Hyperlink>
          </TextBlock>
          <TextBlock FontSize="11.5">
            <Hyperlink Click="OnOpenAllReleasesClick" Foreground="#60A5FA">
              GitHub Releases
            </Hyperlink>
          </TextBlock>
        </StackPanel>
      </DockPanel>
    </Grid>
  </ScrollViewer>
</Window>
